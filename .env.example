# Compass mockup — 環境変数テンプレート
# .env.local にコピーして実値を入れる。.env.local は gitignore 済み。
#
# 全部未設定でもモック動作する（ドライランで実ペイロードは生成可能）。

# ─── Coupang Wing OpenAPI ────────────────────────────────────
# Wing > OpenAPIキー発行 で取得。Secret Keyは初回のみ表示なので即保管。
# 設定すると /api/coupang/submit が本番送信モードに切り替わる。
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_USER_ID=

# 事前にWingで登録した返品センター・出荷地のコード
COUPANG_RETURN_CENTER_CODE=
COUPANG_OUTBOUND_PLACE_CODE=

# 出品の本送信ガード。"1" のときだけ実際にCoupangへ送信する（既定=未設定=dry-run）。
# ※テナントのAPI鍵(tenant_integrations)が揃っていても、これが1でなければ送信しない。
# ★固定IPをCoupang許可リストに登録してから 1 にすること。
COUPANG_LIVE_SEND=

# 【開発用】擬似送信。"1" なら実キー無しでも「送信」で 審査中(submitted) まで進める
# （実送信はしない。ローカルで 送信→審査中→状態同期→販売中 の流れを確認する用）。本番では未設定に。
COUPANG_MOCK_SEND=

# ─── Amazon SP-API ───────────────────────────────────────────
# 設定すると /api/coupang/dry-run の SP-API ステップが本番呼出に切り替わる。
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_LWA_CLIENT_ID=
AMAZON_SP_API_LWA_CLIENT_SECRET=
AMAZON_SP_API_AWS_ACCESS_KEY=
AMAZON_SP_API_AWS_SECRET_KEY=
AMAZON_SP_API_MARKETPLACE_ID=A1VC38T7YXB528

# ─── DeepL（翻訳）────────────────────────────────────────────
# 末尾が ":fx" なら無料プラン、なければ Pro と判定
DEEPL_API_KEY=

# ─── データベース（Postgres / Neon）★P1で必須 ──────────────────
# Neon (https://neon.tech) でプロジェクト作成→接続文字列をコピー。
# 例: postgresql://USER:PASSWORD@ep-xxxx.ap-northeast-1.aws.neon.tech/dbname?sslmode=require
# ※同時アクセス対策で「Pooled connection」のURLを推奨。
DATABASE_URL=

# 実行時アプリ用の最小権限ロール接続（RLS対象）。`npm run db:app-role` が自動生成。
# 未設定なら DATABASE_URL(owner) にフォールバック（RLSはbypass＝アプリ層のみ）。
# セットアップ手順は docs/OPERATIONS.md「RLS」。
APP_DATABASE_URL=

# セッションCookie署名/トークン用のランダム秘密鍵（32文字以上）。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── 連携シークレット暗号化マスター鍵（テナント別API鍵の暗号化用）★必須 ──────
# 加盟店が設定する Amazon/Coupang のAPI鍵は、この鍵でAES-256-GCM暗号化してDB保存する。
# 生成: npm run set-secrets-key （.env.local に base64 32byte を自動生成）
# ⚠️ 一度運用開始したら変更不可（変えると既存の暗号化データが復号できなくなる）。
# ⚠️ 環境ごとに別の値。漏れると全テナントの連携鍵が漏れる→env管理＋ローテーション手順厳守。
SECRETS_MASTER_KEY=

# 本部(owner)初期アカウント（seedで作成）。
OWNER_EMAIL=hirohohashimoto@gmail.com
OWNER_NAME=橋本
OWNER_INITIAL_PASSWORD=
